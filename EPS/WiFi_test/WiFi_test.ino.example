#include <WiFi.h>

// ⚠️ IMPORTANTE: Modifica le credenziali della tua rete WiFi
// Sostituisci con il tuo SSID e password
const char* ssid     = "YOUR_SSID_HERE";
const char* password = "YOUR_PASSWORD_HERE";

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.print("Connessione a ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  // Attende la connessione
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi connesso!");
  Serial.print("IP assegnato: ");
  Serial.println(WiFi.localIP());
}

void loop() {
  // Qui puoi aggiungere il tuo codice
}
